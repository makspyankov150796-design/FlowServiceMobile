void __fastcall TDebugForm::OnAddMSGForm()
{
    UnicodeString String;

    do
    {

    if ( SetOnCheckBox->IsChecked == false )
    {
       break;
    }


    if (CheckBox5->IsChecked == false )
    {
       if ((Debug->MSG.Type=="RD")&&(CheckBox1->IsChecked == false ))
    {
       break;
    }

    if ((Debug->MSG.Type=="WD")&&(CheckBox2->IsChecked == false ))
    {
       break;
    }

	if ((Debug->MSG.Type=="SYS")&&(CheckBox4->IsChecked == false ))
    {
       break;
    }


	if ((Debug->MSG.Type=="ENT")&&(CheckBox4->IsChecked == false ))
    {
       break;
    }
     }
     else

     {
       	if ((Debug->MSG.Type=="RWD")||(Debug->MSG.Type=="RRD")||(Debug->MSG.Type=="PHT")||(Debug->MSG.Type=="ERR"))
    {

    }    else

    {
        break;
    }
    }

    String =  Debug->MSG.Type+" : "+Debug->MSG.Direction+" :: "+Debug->MSG.Time+ ":"+IntToStr(MilliSecondOf(TimeOf(Debug->MSG.Time)))+" ::     "+Debug->MSG.msg+" **"+Debug->MSG.Data;
   //  ///DebugMemo->Lines->Append(Debug->MSG->msg);
    DebugMemo->Lines->Append(" " );
      DebugMemo->Lines->Append(String);

    if (Debug->state == 1)
    {
     if   (DataReadComboBox->ItemIndex==0)
{
    DataReadEdit->Text =   IntToStr(Debug->Int);
}
else if (DataReadComboBox->ItemIndex==1)
{
    DataReadEdit->Text =  IntToHex(Debug->Int);
}
else if (DataReadComboBox->ItemIndex==2)
{
     DataReadEdit->Text =  FloatToStr(Debug->Float);
}
else if (DataReadComboBox->ItemIndex==3)
{
        DataReadEdit->Text =  Debug->Str;
}
       Debug->state = 0;
    }


    } while (0);
}
