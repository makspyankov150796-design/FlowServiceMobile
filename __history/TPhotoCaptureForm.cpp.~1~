void __fastcall TPhotoCaptureForm::ButtonMonitorClick(TObject *Sender)
{
 time =  0;

   if (ButtonMonitor->Tag == 0)
   {
    ButtonMonitor->IsPressed = true;
    ButtonMonitor->Tag = 1;

	TestMeter->ResetTest();
	EtalonMeter->ResetTest();
    TestMeter->SetEtalon(EtalonMeter);


		Anim1->Enabled=true;
	Anim2->Enabled=    false;

    HSC->StartMonitor();

   }
   else
   {
    ButtonMonitor->IsPressed = false;
    ButtonMonitor->Tag = 0;

	HSC->StopMonitor();

    Glow1->Enabled=false;
    Anim1->Enabled=false;
    Anim2->Enabled=true;

   }
}
